    craftRecipe MakeGingerBugTonic
    {
        timedAction = MixingMortarPestle,
        time = 150,
        NeedToBeLearn = true,
        Tags = AnySurfaceCraft;Health,
        category = EHRMedicine,
        AutoLearnAll = Doctor:5;PlantScavenging:4,
        OnTest = RecipeCodeOnTest.EHRFreshMedicinalIngredients,
        inputs
        {
            item 1 tags[base:mortarpestle] mode:keep,
            item 1 [Base.PopBottle;Base.PopBottleRare;Base.WaterBottle] flags[IsEmpty;ItemCount],
            item 1 [*],
            -fluid 0.3 categories[Water] mode:mixture,
            item 1 [Base.Honey] flags[ItemCount],
            item 1 [Base.GingerRoot] flags[ItemCount],
            item 1 [Base.Chamomile;Base.CommonMallow] flags[ItemCount],
            item 2 [Base.Cricket;Base.Grasshopper] flags[ItemCount],
        }
        outputs
        {
            item 1 HARMONIEHomeMedic.GingerBugTonic,
        }
    }

