local function HasPowerLaser(item)
    local modData = item:getModData().LaserBatteryReamin
    if not modData then
        modData = 100
        item:getModData().LaserBatteryReamin = modData
    end
    return modData > 0
end

local function HasPowerLight(item)
    local modData = item:getModData().LightBatteryReamin
    if not modData then
        modData = 100
        item:getModData().LightBatteryReamin = modData
    end
    return modData > 0
end

local function LocalLaserUpdate(playerObj)
    local MainGun = playerObj:getPrimaryHandItem()
    if not MainGun or not MainGun:IsWeapon() or not MainGun:isRanged() then
        return
    end
    local Laser = MainGun:getWeaponPart("Laser")
    local modData = MainGun:getModData().NowLightSet
    if not modData then
        modData = {
            Type = "LaserAndGunLight",
            IsLaserOn = false,
            IsGunLightOn = false
        }
    end
    local LightSet = modData.Type
    if Laser then

        if AWCWF_LaserAndGunLightSet[Laser:getType()] then
            local LaserBeam = MainGun:getHide_Beam()
            if not LaserBeam and (LightSet == "LaserAndGunLight" or LightSet == "Laser") and HasPowerLaser(MainGun) then
                local LaserBeam = instanceItem(AWCWF_LaserAndGunLightSet[Laser:getType()].Beam)
                MainGun:setWeaponPart("Hide_Beam", LaserBeam)
                modData.IsLaserOn = true
            else
                if LaserBeam and (LightSet == "GunLight" or LightSet == "nil") then
                    MainGun:setWeaponPart("Hide_Beam", nil)
                    modData.IsLaserOn = false
                end
            end
        end
    end
    local Light = MainGun:getWeaponPart("Light")
    if Light then
        if not MainGun:isTorchCone() and (LightSet == "LaserAndGunLight" or LightSet == "GunLight") and
            HasPowerLight(MainGun) then
            MainGun:setTorchCone(true)
            MainGun:setLightDistance(Light:getLightDistance())
            MainGun:setLightStrength(Light:getLightStrength())
            modData.IsGunLightOn = true
        else
            if MainGun:isTorchCone() and (LightSet == "Laser" or LightSet == "nil") then
                MainGun:setTorchCone(false)

                MainGun:setLightDistance(0.0)
                MainGun:setLightStrength(0.0)
                modData.IsGunLightOn = false
            end
        end
    else

        if MainGun:isTorchCone() and (LightSet == "Laser" or LightSet == "nil") then
            MainGun:setTorchCone(false)
            MainGun:setLightDistance(0.0)
            MainGun:setLightStrength(0.0)
            modData.IsGunLightOn = false
        end
    end

end

Events.OnPlayerUpdate.Add(LocalLaserUpdate)

local function KeyCheck(_key)
    if _key == getCore():getKey("SwtichLightSet") then
        local player = getPlayer()
        if player and player:getPrimaryHandItem() ~= nil then
            local MainGun = player:getPrimaryHandItem()
            if (MainGun and MainGun:IsWeapon() and MainGun:isRanged()) then

                ISTimedActionQueue.add(ISSwitchLasetAction:new(player, 15, MainGun))

            end
        end
    end
end
local function init()
    Events.OnKeyPressed.Add(KeyCheck)
end
Events.OnGameStart.Add(init)

local callback_ISToolTipInv_render = ISToolTipInv.render
local smallFontHeight = getTextManager():getFontHeight(UIFont.Small) + 5

local function drawText(self, data)
    local tooltipHeight = 5
    local tooltipWidth = self.tooltip:getWidth()
    for _, v in pairs(data) do

        tooltipWidth = math.max(tooltipWidth, getTextManager():MeasureStringX(UIFont.Small, v.desc) + 5)

        tooltipHeight = tooltipHeight + smallFontHeight
    end
    self:drawRect(0, -tooltipHeight, tooltipWidth, tooltipHeight, self.backgroundColor.a, self.backgroundColor.r,
        self.backgroundColor.g, self.backgroundColor.b)
    self:drawRectBorder(0, -tooltipHeight, tooltipWidth, tooltipHeight, self.borderColor.a, self.borderColor.r,
        self.borderColor.g, self.borderColor.b)
    local x = 5
    local y = -tooltipHeight + 5
    for _, v in pairs(data) do
        self:drawText(v.desc, x, y, 1, 1, 0, 1, UIFont.Small)
        y = y + smallFontHeight
    end
end

local function PowerDown()
    local playerObj = getPlayer()
    if not playerObj then
        return
    end
    local MainGun = playerObj:getPrimaryHandItem()
    if not MainGun or not MainGun:IsWeapon() or not MainGun:isRanged() then
        return
    end

    local Laser = MainGun:getWeaponPart("Laser")
    if Laser then
        local modData = MainGun:getModData().LaserBatteryReamin
        if not modData then
            modData = 100
            MainGun:getModData().LaserBatteryReamin = modData
        end
        if modData and modData > 0 and IsLaserOn then
            modData = modData - 0.1
            MainGun:getModData().LaserBatteryReamin = round(modData, 1)
        end
    end
    local Light = MainGun:getWeaponPart("Light")
    if Light then
        local modData = MainGun:getModData().LightBatteryReamin
        if not modData then
            modData = 100
            MainGun:getModData().LightBatteryReamin = modData
        end
        if modData and modData > 0 and IsGunLightOn then
            modData = modData - 0.1
            MainGun:getModData().LightBatteryReamin = round(modData, 1)
        end
    end
end

Events.EveryOneMinute.Add(PowerDown)

function ISToolTipInv:render()
    callback_ISToolTipInv_render(self)
    local item = self.item
    local data = {}
    if instanceof(item, "WeaponPart") then
        if item:getPartType() == "Laser" then
            local modData = item:getModData().LaserBatteryReamin
            if not modData then
                modData = 100
                item:getModData().LaserBatteryReamin = modData
            end
            table.insert(data, {
                desc = getText("IGUI_Light_BatteryRemaining_Laser") .. modData
            })
        end
        if item:getPartType() == "Light" then
            local modData = item:getModData().LightBatteryReamin
            if not modData then
                modData = 100
                item:getModData().LightBatteryReamin = modData
            end
            table.insert(data, {
                desc = getText("IGUI_Light_CurrentLightSet_GunLight") .. modData
            })
        end
        drawText(self, data)
    end
    if item:IsWeapon() and item:isRanged() then
        local Laser = item:getWeaponPart("Laser")
        local Light = item:getWeaponPart("Light")
        if item then
            if (Laser) then
                local modData = item:getModData().LaserBatteryReamin
                if not modData then
                    modData = 100
                end

                table.insert(data, {
                    desc = getText("IGUI_Light_BatteryRemaining_Laser") .. modData
                })

            end
            if (Light) then
                local modData = Light:getModData().LightBatteryReamin
                if not modData then
                    modData = 100
                end
                table.insert(data, {
                    desc = getText("IGUI_Light_BatteryRemaining_GunLight") .. modData
                })
            end
            drawText(self, data)
        end
    end
end
