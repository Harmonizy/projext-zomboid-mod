# Only track mods/ and Workshop/ -- everything else in the Zomboid user
# data folder is game state, logs, or saves, not mod source/staging.
/*
!/mods/
!/Workshop/
!/.gitignore
# Claude Code project permissions (only this one file of .claude/)
!/.claude/
/.claude/*
!/.claude/settings.json
!/3633421539
!console.txt
# The game writes its own current mod-selection list here every time the
# player changes mods in-game -- it's local play state, not mod source, and
# kept showing up as unrelated drift in git status. Untracked 2026-09-22.
mods/default.txt
